AI_SERVICE_TOKEN=replace-with-a-long-random-string-shared-with-the-backend
# Choose one provider: openai, gemini, or groq
LLM_PROVIDER=openai
# Keep the keys for every provider you use; LLM_PROVIDER decides which one is called
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: leave blank to use the provider default (gpt-4o-mini, gemini-2.5-flash, or llama-3.3-70b-versatile)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Maximum length of one AI reply; raise it if large blueprints are cut off
LLM_MAX_OUTPUT_TOKENS=8192
