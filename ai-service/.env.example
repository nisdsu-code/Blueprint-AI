AI_SERVICE_TOKEN=replace-with-a-long-random-string-shared-with-the-backend
# Choose one provider: openai or gemini
LLM_PROVIDER=openai
# Fill in the key for the provider you chose
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: leave blank to use the provider default (gpt-4o-mini or gemini-2.5-flash)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
